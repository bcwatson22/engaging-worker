# The deployed site the renderer navigates to. No trailing slash.
SITE_URL=https://www.engaging.engineering

# Cloudflare R2, over the S3 API.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Where uploaded objects are publicly readable.
R2_PUBLIC_BASE=

# Set in the image only. Left unset locally, where go-rod finds its own browser.
# CHROME_PATH=/usr/bin/chromium

# PORT=8080

# Upstash. rediss:// gets TLS; a local redis:// container does not.
REDIS_URL=
